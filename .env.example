# Select one configured target, or a comma-separated list. Never commit .env.
BENCHMARK_TARGETS=cognodb

# CognoDB Cloud (required for the assignment)
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Neo4j AuraDB / Memgraph Cloud use their Bolt URIs and account credentials.
NEO4J_AURA_URI=
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=
MEMGRAPH_URI=
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ArangoGraph TLS connection. Copy ARANGO_CA_BASE64 from the generated Java
# driver snippet in the deployment console; keep it local.
ARANGO_HOST=
ARANGO_PORT=18529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DATABASE=benchmark
ARANGO_CA_BASE64=

# Keep this deliberately small for entry/free tiers.
BENCHMARK_ITERATIONS=100
BENCHMARK_WARMUP=20
BENCHMARK_CONCURRENCY=10
BENCHMARK_WRITE_RATIO=0.10
